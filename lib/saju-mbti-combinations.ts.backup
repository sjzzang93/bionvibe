// 간단한 조합 분석 (위 데이터에 없는 조합용)
export function getBasicCombinationAnalysis(element: string, mbti: string): CombinationAnalysis {
  const elementTraits: Record<string, any> = {
    "목": { name: "목(木)", icon: "🌳", traits: ["성장", "창의", "유연"], luckyColor: ["초록"], direction: "동쪽" },
    "화": { name: "화(火)", icon: "🔥", traits: ["열정", "활발", "사교"], luckyColor: ["빨강"], direction: "남쪽" },
    "토": { name: "토(土)", icon: "⛰️", traits: ["안정", "신뢰", "포용"], luckyColor: ["노랑"], direction: "중앙" },
    "금": { name: "금(金)", icon: "⚔️", traits: ["결단", "정의", "원칙"], luckyColor: ["흰색"], direction: "서쪽" },
    "수": { name: "수(水)", icon: "💧", traits: ["지혜", "유연", "사색"], luckyColor: ["파랑"], direction: "북쪽" }
  };

  const mbtiTraits: Record<string, any> = {
    "INTJ": { nickname: "전략가", icon: "♟️" },
    "INTP": { nickname: "논리술사", icon: "🧪" },
    "ENTJ": { nickname: "통솔자", icon: "👑" },
    "ENTP": { nickname: "변론가", icon: "💡" },
    "INFJ": { nickname: "옹호자", icon: "🕊️" },
    "INFP": { nickname: "중재자", icon: "🦋" },
    "ENFJ": { nickname: "선도자", icon: "🌟" },
    "ENFP": { nickname: "활동가", icon: "🎉" },
    "ISTJ": { nickname: "현실주의자", icon: "📋" },
    "ISFJ": { nickname: "수호자", icon: "🛡️" },
    "ESTJ": { nickname: "경영자", icon: "⚖️" },
    "ESFJ": { nickname: "집정관", icon: "🤝" },
    "ISTP": { nickname: "장인", icon: "🔧" },
    "ISFP": { nickname: "모험가", icon: "🎨" },
    "ESTP": { nickname: "사업가", icon: "🎯" },
    "ESFP": { nickname: "연예인", icon: "🎭" }
  };

  const el = elementTraits[element];
  const mb = mbtiTraits[mbti];

  return {
    combination: `${el.icon}${mb.icon} ${el.name} × ${mb.nickname}`,
    summary: `${element}의 특성과 ${mbti}의 성향이 조화를 이룹니다.`,
    personality: `${element}의 ${el.traits.join(", ")} 특성과 ${mbti}의 성격이 결합되어 독특한 개성을 만듭니다.`,
    cognitiveStyle: `${mbti}의 인지 기능에 ${element} 에너지가 더해집니다.`,
    strength: ["균형잡힌 발전", "독특한 강점", "조화로운 성격"],
    weakness: ["자기 이해 필요", "균형 유지 중요"],
    interpersonal: `${mbti} 스타일의 관계에 ${element}의 특성이 더해집니다.`,
    love: `${element}의 특성이 반영된 ${mbti} 스타일의 사랑.`,
    money: "균형잡힌 재정 관리가 필요합니다.",
    health: `${element} 에너지 균형을 유지하세요.`,
    balance: "오행 균형을 고르게 유지하세요.",
    luckyColor: el.luckyColor,
    luckyDirection: el.direction,
    stressResponse: `${mbti} 특유의 방식으로 스트레스를 해소합니다.`,
    workStyle: `${element}의 특성이 반영된 ${mbti} 스타일의 업무 방식.`,
    leadership: `${element}의 에너지가 더해진 ${mbti} 스타일의 리더십.`,
    creativity: `${element}과 ${mbti}가 결합된 창의성.`,
    jobs: ["창의적 직업", "분석 직업", "소통 직업"]
  };
}

